# Copy to `.env` and fill in. `.env` is gitignored; this file never holds a real value.
#
# The defaults below are a WORKING configuration: with no edits at all the
# service runs against the bundled GoHighLevel mock and the deterministic
# qualifier, which is how the demo and the tests run with no accounts.

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
# json for a log aggregator, text while developing.
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite needs nothing installed and is correct for a single process.
# Switch to Postgres the moment there is more than one worker - see
# docs/architecture.md#storage. The sync form is accepted and upgraded to the
# async driver automatically.
DATABASE_URL=sqlite+aiosqlite:///./local.sqlite3
# DATABASE_URL=postgresql+asyncpg://leadops:CHANGE_ME@localhost:5432/leadops

# ---------------------------------------------------------------------------
# Webhook security
# ---------------------------------------------------------------------------
# HMAC-SHA256 over "{timestamp}.{raw body}", sent as:
#   X-Signature: t=<unix seconds>,v1=<hex digest>
# Generate one with:  python -c "import secrets; print('whsec_' + secrets.token_hex(32))"
# Leave empty in local development: requests are accepted but recorded as
# unverified, and /admin/stats counts them. It never claims a verification that
# did not happen.
WEBHOOK_SIGNING_SECRET=
# Set true in staging and production. With no secret configured this makes the
# service reject every request, which is the correct way to fail.
REQUIRE_SIGNATURE=false
WEBHOOK_MAX_SKEW_SECONDS=300

# ---------------------------------------------------------------------------
# GoHighLevel (LeadConnector API v2)
# ---------------------------------------------------------------------------
# Local mock (default):        http://127.0.0.1:8081
# Real API:                    https://services.leadconnectorhq.com
GHL_BASE_URL=http://127.0.0.1:8081

# Pinned deliberately: GHL ships breaking changes behind new version dates.
GHL_API_VERSION=2021-07-28

# A sub-account Private Integration token (Settings -> Private Integrations),
# or an OAuth access token. Scopes needed: contacts.write, contacts.readonly,
# opportunities.write, opportunities.readonly, conversations/message.write,
# locations/customFields.readonly, calendars.readonly (+ calendars/events.write
# only if you enable the appointment node).
# OAuth access tokens expire in 24h - see docs/ghl-integration.md#oauth.
GHL_ACCESS_TOKEN=

# Account-specific ids. NOT secrets - they identify, they do not authorise - but
# they are wrong on every account except the one they came from. Generate a
# filled config/ghl-mapping.json with:  python scripts/discover_ghl_ids.py
GHL_LOCATION_ID=loc_DEMO0000000000000000
GHL_PIPELINE_ID=pipe_DEMO000000000000000

GHL_TIMEOUT_SECONDS=10
GHL_MAX_ATTEMPTS=4
GHL_BACKOFF_BASE_SECONDS=0.25
GHL_BACKOFF_MAX_SECONDS=8

# ---------------------------------------------------------------------------
# AI qualification
# ---------------------------------------------------------------------------
# deterministic | anthropic | openai
# `deterministic` runs offline keyword rules: no key, no cost, no network. It is
# also the fallback whenever a live provider fails, so the system never stops
# scoring leads because a model is down.
AI_PROVIDER=deterministic

# Only read when AI_PROVIDER is anthropic or openai. A live provider with no key
# silently falls back to deterministic rather than refusing to start - a
# half-configured deployment should still accept leads.
AI_API_KEY=

# anthropic: claude-sonnet-5 | openai: gpt-4o-mini
AI_MODEL=claude-sonnet-5
AI_TIMEOUT_SECONDS=20
# 1 call + 1 schema-repair call. Beyond that the rules engine takes over.
AI_MAX_ATTEMPTS=2
AI_TEMPERATURE=0.0

# ---------------------------------------------------------------------------
# Routing
# ---------------------------------------------------------------------------
ROUTING_CONFIG_PATH=config/routing.yml
GHL_MAPPING_PATH=config/ghl-mapping.json

# ---------------------------------------------------------------------------
# Reliability
# ---------------------------------------------------------------------------
# An event still `processing` after this many seconds is assumed to belong to a
# crashed worker and may be reclaimed by the next delivery.
PROCESSING_LEASE_SECONDS=300
# Deliveries before a retryable failure becomes a dead letter.
MAX_DELIVERY_ATTEMPTS=5

SALES_NOTIFICATION_EMAIL=sales@example.com

# ---------------------------------------------------------------------------
# n8n (read by the workflow, not by this service)
# ---------------------------------------------------------------------------
LEADOPS_BASE_URL=http://127.0.0.1:8000
GHL_CALENDAR_ID=cal_DEMO0000000000000000
